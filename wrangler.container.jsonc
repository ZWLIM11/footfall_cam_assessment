{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "footfall-cam-assessment",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "containers": [
    {
      "class_name": "Detector",
      "scheduling_policy": "durable_object",
      "images": { "base": { "dockerfile": "./Dockerfile" } }
    }
  ],
  "durable_objects": { "bindings": [{ "name": "DETECTOR", "class_name": "Detector" }] },
  "exports": { "Detector": { "type": "durable-object", "storage": "sqlite" } }
}
